<!--
    This file contains Runtime Directives used by .NET Native.
    They define which metadata for types, methods and other code elements
    is available for reflection and other dynamic code patterns.
-->
<Directives xmlns="http://schemas.microsoft.com/netfx/2013/01/metadata">
  <Application>
    <Assembly Name="*Application*" Dynamic="Required All" />
    <Assembly Name="Newtonsoft.Json" Dynamic="Required All" />
    <Assembly Name="NVorbis" Dynamic="Required All" />
    <Assembly Name="MoonSharp.Interpreter" Dynamic="Required All" />
    <!-- Psych HScript runtime (hscript-iris compiled from Haxe): reflection-driven, keep all metadata -->
    <Assembly Name="HScriptIris" Dynamic="Required All" />
    <!-- Video cutscenes (Engine/VideoCutscenePlayer.cs): ContentTypeReaderManager creates these readers by name -->
    <Assembly Name="MonoGame.Framework">
      <Type Name="Microsoft.Xna.Framework.Content.VideoReader" Dynamic="Required All" />
      <Type Name="Microsoft.Xna.Framework.Content.StringReader" Dynamic="Required All" />
      <Type Name="Microsoft.Xna.Framework.Content.Int32Reader" Dynamic="Required All" />
      <Type Name="Microsoft.Xna.Framework.Content.SingleReader" Dynamic="Required All" />
      <!-- PlayScene.GpuWarmup reads GraphicsDevice._resources (live texture list) by reflection -->
      <Type Name="Microsoft.Xna.Framework.Graphics.GraphicsDevice" Dynamic="Required All" />
    </Assembly>
  </Application>
</Directives>
