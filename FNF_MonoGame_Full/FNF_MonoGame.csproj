<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>FNF_MonoGame</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DefaultItemExcludes>$(DefaultItemExcludes);Xbox\**;Engine\PsychEngine\Editors\**;Engine\PsychEngine\Stages\**;Engine\PsychEngine\States\**;Engine\PsychEngine\Options\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.3.7" />
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="DiscordRichPresence" Version="1.2.1.24" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="SharpCompress" Version="0.32.2" />
  </ItemGroup>

  <!-- Psych Engine HScript runtime: hscript-iris 1.1.3 compiled from the original Haxe source to C#.
       Extern alias keeps Haxe's global-namespace std types (Math, Type, Array) away from engine code. -->
  <ItemGroup>
    <ProjectReference Include="..\HScriptIris_CS\HScriptIris.csproj" Aliases="IRIS" />
  </ItemGroup>
  <!-- Restored HaxeScriptRuntime for Psych Engine mod compatibility -->
  <ItemGroup>
    <Reference Include="HaxeScriptRuntime">
      <HintPath>HaxeScriptRuntime.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- Copy Content folder to output -->
  <ItemGroup>
    <None Remove="Content\**\*" />
    <Content Include="Content\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- For Xbox NativeAOT compatibility -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <Import Project="$(SolutionDir)NativeAOT_Console.targets" Condition="Exists('$(SolutionDir)NativeAOT_Console.targets')" />

</Project>
