<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Psych Engine's HScript runtime (hscript-iris 1.1.3), compiled from the ORIGINAL Haxe source
    to C# by the Haxe C# target (see build.hxml / regenerate.sh). netstandard2.0 so the same
    library is used by the desktop (net8.0) and UWP/Xbox (.NET Native) builds.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>HScriptIris</AssemblyName>
    <RootNamespace>HScriptIris</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0108;CS0109;CS0114;CS0162;CS0164;CS0168;CS0169;CS0219;CS0414;CS0649;CS0659;CS0660;CS0661;CS1717;CS8632</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="gen\src\**\*.cs" />
  </ItemGroup>
</Project>
